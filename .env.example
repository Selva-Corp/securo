# Copy to .env and fill in.
# SQLite for local development. Swap the provider in prisma/schema.prisma to
# "postgresql" and point this at a Postgres URL for production.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Optional. Encrypts stored bank access URLs; falls back to AUTH_SECRET.
# ENCRYPTION_KEY="another-random-string"
